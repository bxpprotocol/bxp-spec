# BXP Protocol Node — Environment Variables
# Copy this file to .env and fill in your values

# AQICN API token (free at https://aqicn.org/api/)
AQICN_TOKEN=

# Node identity
BXP_NODE_ID=bxp-node-001
BXP_NODE_TYPE=reference

# SDK / CLI default server
BXP_SERVER_URL=http://localhost:5000

# SDK / CLI device token (from POST /bxp/v2/devices/register)
BXP_DEVICE_TOKEN=

# Shared secret required (as "Authorization: Bearer <secret>") to call
# GET /bxp/v2/sync. If unset, /sync is open. This is a placeholder for the
# node trust system SPEC.md §7 defers to a future RFC. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BXP_NODE_SYNC_TOKEN=

# Set to true ONLY if the server runs behind a reverse proxy that
# overwrites X-Forwarded-For. If exposed directly, leave unset — otherwise
# any client can spoof its IP and bypass per-IP rate limits.
BXP_TRUST_PROXY_HEADERS=

# Database file location (default: reference-server/bxp_data.db).
# The Docker image sets this to /data/bxp_data.db (a volume).
BXP_DB_PATH=

# Maximum accepted request body in bytes (default 8388608 = 8 MiB).
BXP_MAX_BODY_BYTES=
