# BXP Protocol Node — Environment Variables
# Copy this file to .env and fill in your values

# AQICN API token (free at https://aqicn.org/api/)
AQICN_TOKEN=

# Node identity
BXP_NODE_ID=bxp-node-001
BXP_NODE_TYPE=reference

# SDK / CLI default server
BXP_SERVER_URL=http://localhost:5000

# SDK / CLI device token (from POST /bxp/v2/devices/register)
BXP_DEVICE_TOKEN=
