{
  "name": "bxp-sdk",
  "version": "2.1.0",
  "type": "module",
  "description": "BXP Protocol SDK \u2014 Breathe Exposure Protocol for atmospheric exposure data",
  "main": "dist/bxp-sdk.js",
  "module": "dist/bxp-sdk.js",
  "types": "dist/bxp-sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bxp-sdk.d.ts",
      "import": "./dist/bxp-sdk.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "conformance": "node ../../conformance/verify_typescript.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run conformance && npm run build"
  },
  "keywords": [
    "air-quality",
    "atmospheric",
    "bxp",
    "iot",
    "health",
    "sensor"
  ],
  "author": "BXP Protocol <bxpprotocol@proton.me>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/bxpprotocol/bxp-spec",
  "repository": {
    "type": "git",
    "url": "https://github.com/bxpprotocol/bxp-spec"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
