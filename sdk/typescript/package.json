{
  "name": "bxp-sdk",
  "version": "2.1.0",
  "description": "BXP Protocol SDK — Breathe Exposure Protocol for atmospheric exposure data",
  "main": "dist/bxp-sdk.js",
  "module": "dist/bxp-sdk.esm.js",
  "types": "dist/bxp-sdk.d.ts",
  "exports": {
    ".": {
      "import": "./dist/bxp-sdk.esm.js",
      "require": "./dist/bxp-sdk.js",
      "types": "./dist/bxp-sdk.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc && rollup -c",
    "test":  "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": ["air-quality", "atmospheric", "bxp", "iot", "health", "sensor"],
  "author": "BXP Protocol <bxpprotocol@proton.me>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/bxpprotocol/bxp-spec",
  "repository": {
    "type": "git",
    "url": "https://github.com/bxpprotocol/bxp-spec"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "rollup": "^4.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "engines": { "node": ">=18" }
}
