# BXP Protocol — Development Environment Configuration
# Copy this file to .env and customize for your environment
# All variables are optional; defaults shown as comments

# ──────────────────────────────────────────────────────────────
# REFERENCE SERVER (reference-server/server.py)
# ──────────────────────────────────────────────────────────────

# Database path (SQLite)
# Default: reference-server/bxp.db
BXP_DB_PATH=reference-server/bxp.db

# Server bind address and port
# Default: 0.0.0.0:5000
BXP_HOST=0.0.0.0
BXP_PORT=5000

# Maximum request body size (bytes)
# Default: 8388608 (8 MiB)
BXP_MAX_BODY_BYTES=8388608

# Maximum decompressed binary payload size (bytes)
# Default: 16777216 (16 MiB) — prevents decompression bombs
BXP_MAX_DECOMPRESSED_BYTES=16777216

# Trust X-Forwarded-For header for rate limiting
# ONLY set to "true" behind a trusted reverse proxy (nginx, Caddy, Cloudflare)
# that overwrites the header. Default: false
BXP_TRUST_PROXY_HEADERS=false

# Rate limiting: requests per minute per IP
# Default: 60
BXP_RATE_LIMIT_RPM=60

# Rate limiting: device registration per minute per IP
# Default: 5
BXP_RATE_LIMIT_DEVICE_REG_RPM=5

# Node-to-node sync authentication token
# Set to a strong random secret (32+ chars) to enable /sync endpoint
# If unset, /sync is OPEN (no auth) — NOT recommended for production
# Generate with: openssl rand -hex 32
BXP_NODE_SYNC_TOKEN=

# AQICN API token for live global city data
# Free at https://aqicn.org/api/
# If unset, city endpoints return sample data only
AQICN_TOKEN=

# Log level: DEBUG, INFO, WARNING, ERROR
# Default: INFO
BXP_LOG_LEVEL=INFO

# Enable structured JSON logging (for log aggregation)
# Default: false
BXP_JSON_LOGS=false

# ──────────────────────────────────────────────────────────────
# PYTHON SDK (sdk/python/bxp_sdk.py)
# ──────────────────────────────────────────────────────────────

# Default timeout for HTTP requests (seconds)
# Default: 30
BXP_SDK_TIMEOUT=30

# Default number of retries for failed requests
# Default: 3
BXP_SDK_RETRIES=3

# Default backoff factor for retries (exponential)
# Default: 0.5
BXP_SDK_BACKOFF=0.5

# ──────────────────────────────────────────────────────────────
# CLI TOOL (cli/bxp_cli.py)
# ──────────────────────────────────────────────────────────────

# Default server URL for submit commands
# Default: http://localhost:5000
BXP_CLI_DEFAULT_SERVER=http://localhost:5000

# Default output format: json, csv, table
# Default: json
BXP_CLI_OUTPUT_FORMAT=json

# ──────────────────────────────────────────────────────────────
# INTEGRATIONS
# ──────────────────────────────────────────────────────────────

# OpenAQ API key (optional, higher rate limits)
# https://docs.openaq.org/
OPENAQ_API_KEY=

# PurpleAir API key (for future PurpleAir importer)
# https://api.purpleair.com/
PURPLEAIR_API_KEY=

# MQTT broker for mqtt_bridge.py
# Default: mqtt://localhost:1883
BXP_MQTT_BROKER=mqtt://localhost:1883

# MQTT topic prefix for BXP messages
# Default: bxp/
BXP_MQTT_TOPIC_PREFIX=bxp/

# ──────────────────────────────────────────────────────────────
# CONFORMANCE TESTING
# ──────────────────────────────────────────────────────────────

# Path to conformance vectors
# Default: conformance/vectors
BXP_CONFORMANCE_VECTORS=conformance/vectors

# ──────────────────────────────────────────────────────────────
# DEVELOPMENT / CI
# ──────────────────────────────────────────────────────────────

# Python version for CI (comma-separated)
# Default: 3.10,3.11,3.12
CI_PYTHON_VERSIONS=3.10,3.11,3.12

# Node.js version for CI
# Default: 20
CI_NODE_VERSION=20

# Skip slow tests in CI (integration tests with external deps)
# Default: false
CI_SKIP_SLOW_TESTS=false

# ──────────────────────────────────────────────────────────────
# DOCKER
# ──────────────────────────────────────────────────────────────

# Docker image name
# Default: bxp-protocol/bxp-spec
DOCKER_IMAGE=bxp-protocol/bxp-spec

# Docker tag
# Default: latest
DOCKER_TAG=latest

# ──────────────────────────────────────────────────────────────
# PACKAGING / RELEASE
# ──────────────────────────────────────────────────────────────

# PyPI API token (for release workflow)
# Set as GitHub secret: PYPI_API_TOKEN
# PYPI_API_TOKEN=

# npm token (for release workflow)
# Set as GitHub secret: NPM_TOKEN
# NPM_TOKEN=

# GitHub token (automatically provided in Actions as GITHUB_TOKEN)
# GITHUB_TOKEN=